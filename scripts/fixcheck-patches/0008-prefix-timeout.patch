+    if (timeoutMillis > 0) runner.join(timeoutMillis);
+    else runner.join();
+    if (runner.isAlive()) {
+      stop(runner);
+      return null;
+    }
+    if (crash[0] != null) throw new RuntimeException("Prefix runner crashed", crash[0]);
+    return outcome[0];
+  }
