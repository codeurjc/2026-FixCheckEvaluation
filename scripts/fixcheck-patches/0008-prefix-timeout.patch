+   * @return the result, or null if the request did not finish in time
+   * @throws InterruptedException if the calling thread is interrupted while waiting
+   */
+  public static Result runWithTimeout(final JUnitCore core, final Request request,
+                                      ClassLoader contextLoader, long timeoutMillis)
+      throws InterruptedException {
+    final Result[] outcome = new Result[1];
+    final Throwable[] crash = new Throwable[1];
+    Thread runner = new Thread(() -> {
+      try {
+        outcome[0] = core.run(request);
+      } catch (Throwable t) {
+        crash[0] = t;
+      }
+    }, "fixcheck-prefix-runner");
+    runner.setDaemon(true);
