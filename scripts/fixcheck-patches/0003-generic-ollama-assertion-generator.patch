@@ -0,0 +1,157 @@
+package org.imdea.fixcheck.properties;
+
+/**
+ * OllamaProperty class: resolves which Ollama model the generic
+ * {@code org.imdea.fixcheck.assertion.OllamaGenerator} talks to, and where.
+ *
+ * <p>Unlike {@code CodeLlamaOllama} and {@code Llama3_1Ollama}, which hardcode
+ * both the model tag and {@code http://localhost:11434}, the endpoint here is
+ * configurable in two ways:
+ *
+ * <ul>
+ *   <li>inline in the {@code assertion-generator} option itself, as
+ *       {@code ollama:<model>[@[<host>:]<port>]} -- so a single string can
+ *       travel through a command line; or</li>
+ *   <li>with the standalone {@code ollama-model}, {@code ollama-host} and
+ *       {@code ollama-port} properties.</li>
+ * </ul>
+ *
+ * The inline spec wins over the standalone properties, which in turn win over
+ * the defaults ({@code localhost:11434}).
+ *
+ * <p>The model keeps Ollama's own {@code <model>:<version>} shape
+ * ({@code gpt-oss:120b}); the separator before the endpoint is {@code @}
+ * precisely because a colon is already part of a model tag.
+ *
+ * @author Michel Maes
+ */
+public class OllamaProperty {
+
+  public static final String OPTION_PREFIX = "ollama";
+
+  private static final String DEFAULT_HOST = "localhost";
+  private static final int DEFAULT_PORT = 11434;
+
+  private final String model;
+  private final String host;
+  private final int port;
+
+  private OllamaProperty(String model, String host, int port) {
+    this.model = model;
+    this.host = host;
+    this.port = port;
+  }
+
+  /**
+   * Returns true iff the given {@code assertion-generator} option selects the
+   * generic Ollama generator, i.e. it is {@code ollama} or {@code ollama:...}.
+   */
+  public static boolean isOllamaOption(String option) {
+    return option != null
+        && (option.equals(OPTION_PREFIX) || option.startsWith(OPTION_PREFIX + ":"));
+  }
+
+  /**
+   * Resolve the endpoint from the loaded properties.
+   */
+  public static OllamaProperty fromProperties() {
+    return parse(FixCheckProperties.ASSERTION_GENERATOR_OPTION,
+        FixCheckProperties.OLLAMA_MODEL,
+        FixCheckProperties.OLLAMA_HOST,
+        FixCheckProperties.OLLAMA_PORT);
+  }
+
+  /**
+   * Resolve the endpoint from an inline option spec plus the standalone
+   * property values (any of which may be null / unset).
+   *
+   * @param option the raw {@code assertion-generator} option
+   * @param modelProperty value of {@code ollama-model}, or null
+   * @param hostProperty value of {@code ollama-host}, or null
+   * @param portProperty value of {@code ollama-port}, or a non-positive number when unset
+   * @throws IllegalArgumentException if no model was given, or the spec is malformed
+   */
+  public static OllamaProperty parse(String option, String modelProperty, String hostProperty,
+                                     int portProperty) {
+    String model = modelProperty;
+    String host = hostProperty;
+    int port = portProperty;
+
+    String spec = inlineSpec(option);
+    if (spec != null && !spec.isEmpty()) {
+      // The model tag itself contains colons, so the endpoint is split off at
+      // the last '@' -- a character Ollama model names cannot contain.
+      int at = spec.lastIndexOf('@');
+      String modelPart = (at == -1) ? spec : spec.substring(0, at);
+      String endpointPart = (at == -1) ? "" : spec.substring(at + 1);
+      if (!modelPart.isEmpty()) model = modelPart;
+      if (at != -1 && endpointPart.isEmpty())
+        throw new IllegalArgumentException(
+            "Malformed assertion-generator '" + option + "': nothing after '@'. "
+                + "Expected " + OPTION_PREFIX + ":<model>[@[<host>:]<port>]");
+      if (!endpointPart.isEmpty()) {
+        int colon = endpointPart.lastIndexOf(':');
+        if (colon == -1) {
+          // Bare number is a port; anything else is a host.
+          if (isNumber(endpointPart)) port = parsePort(endpointPart, option);
+          else host = endpointPart;
+        } else {
+          String hostPart = endpointPart.substring(0, colon);
+          if (!hostPart.isEmpty()) host = hostPart;
+          port = parsePort(endpointPart.substring(colon + 1), option);
+        }
+      }
+    }
+
+    if (model == null || model.trim().isEmpty())
+      throw new IllegalArgumentException(
+          "No Ollama model configured. Give it inline as '"
+              + OPTION_PREFIX + ":<model>[@[<host>:]<port>]' (e.g. '"
+              + OPTION_PREFIX + ":gpt-oss:120b@1995') or with the 'ollama-model' property.");
+
+    return new OllamaProperty(model.trim(),
+        (host == null || host.trim().isEmpty()) ? DEFAULT_HOST : host.trim(),
+        (port > 0) ? port : DEFAULT_PORT);
+  }
+
+  /**
+   * The part of the option after the {@code ollama} prefix, or null when the
+   * option does not select this generator at all.
+   */
+  private static String inlineSpec(String option) {
+    if (!isOllamaOption(option)) return null;
+    return option.equals(OPTION_PREFIX) ? "" : option.substring(OPTION_PREFIX.length() + 1);
+  }
+
+  private static boolean isNumber(String value) {
+    if (value.isEmpty()) return false;
+    for (int i = 0; i < value.length(); i++) {
+      if (!Character.isDigit(value.charAt(i))) return false;
+    }
+    return true;
+  }
+
+  private static int parsePort(String value, String option) {
+    if (!isNumber(value))
+      throw new IllegalArgumentException(
+          "Malformed assertion-generator '" + option + "': '" + value + "' is not a port number. "
+              + "Expected " + OPTION_PREFIX + ":<model>[@[<host>:]<port>]");
+    int port = Integer.parseInt(value);
+    if (port <= 0 || port > 65535)
+      throw new IllegalArgumentException(
+          "Malformed assertion-generator '" + option + "': port " + port + " is out of range.");
+    return port;
+  }
+
+  public String getModel() { return model; }
+
+  public String getHost() { return host; }
+
+  public int getPort() { return port; }
+
+  /** The Ollama generate endpoint to POST to. */
+  public String getApiUrl() { return "http://" + host + ":" + port + "/api/generate"; }
+
+  @Override
+  public String toString() { return "model=" + model + " at " + getApiUrl(); }
+}
