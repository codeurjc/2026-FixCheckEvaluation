+package org.imdea.fixcheck.assertion;
+
+import com.github.javaparser.ast.CompilationUnit;
+import org.imdea.fixcheck.assertion.common.AssertionsHelper;
+import org.imdea.fixcheck.prefix.Prefix;
+import org.imdea.fixcheck.properties.FixCheckProperties;
+import org.imdea.fixcheck.properties.OllamaProperty;
+import org.imdea.fixcheck.transform.common.TransformationHelper;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/**
+ * OllamaGenerator class: assertion generator backed by any model served by a
+ * local or remote Ollama daemon.
+ *
+ * <p>Where {@code CodeLlamaOllama} and {@code Llama3_1Ollama} each hardcode one
+ * model tag and {@code http://localhost:11434}, this generator takes both from
+ * the configuration, so a model is selected as {@code ollama:<model>[@[<host>:]<port>]}
+ * (e.g. {@code ollama:gpt-oss:120b@1995}) without touching the sources. See
+ * {@link OllamaProperty} for the accepted forms.
+ *
+ * <p>The prompt asks for bare assertion statements rather than a completed
+ * method: reasoning models answer a "complete this code" prompt by re-emitting
+ * the whole method, often introducing local variables that do not exist in the
+ * prefix, which yields assertions that cannot compile once appended.
+ *
+ * @author Michel Maes
+ */
+public class OllamaGenerator extends AssertionGenerator {
+
+  private static final String SYSTEM = "You are an assertion generator for Java unit tests. "
+      + "You reply with Java assertion statements only: no prose, no markdown, no method or "
+      + "class declarations.";
+
+  /** Assertion calls the response scanner recognizes, optionally qualified. */
+  private static final Pattern ASSERTION_START = Pattern.compile(
+      "^(?:[A-Za-z_][A-Za-z0-9_.]*\\.)?"
+          + "(?:assertEquals|assertNotEquals|assertTrue|assertFalse|assertNotNull|assertNull"
+          + "|assertArrayEquals|assertSame|assertNotSame)\\s*\\(");
+
+  /** Reasoning models that do not use Ollama's separate 'thinking' field inline it instead. */
+  private static final Pattern REASONING_BLOCK = Pattern.compile(
+      "(?s)<(think|thinking|reasoning)>.*?</\\1>");
+
+  private final OllamaProperty endpoint;
+  private final int timeoutMillis;
+
+  /** Used by FixCheck itself, which instantiates generators reflectively. */
+  public OllamaGenerator() {
+    this(OllamaProperty.fromProperties(), FixCheckProperties.OLLAMA_TIMEOUT_SECONDS);
+  }
+
+  public OllamaGenerator(OllamaProperty endpoint, int timeoutSeconds) {
+    this.endpoint = endpoint;
+    this.timeoutMillis = timeoutSeconds * 1000;
+  }
+
+  @Override
+  public void generateAssertions(Prefix prefix) {
+    String prompt = generatePrompt(prefix);
+    System.out.println("prompt:");
+    System.out.println(prompt);
+    String responseText = performCall(prompt);
+    List<String> assertionsStr = getAssertionsFromResponseText(responseText);
+    System.out.println("---> assertions: " + assertionsStr);
+    System.out.println();
+    AssertionsHelper.appendAssertionsToPrefix(assertionsStr, prefix);
+    updateClassName(prefix);
+  }
+
+  /**
+   * Build the prompt: the original test as a reference, the variation to
+   * complete, and the rules that keep the answer appendable as-is.
+   *
+   * @param prefix Prefix to generate the prompt for
+   * @return Prompt for the model
+   */
+  private String generatePrompt(Prefix prefix) {
+    return "Below are two Java unit tests. The second one is a variation of the first, "
+        + "with its assertions removed.\n\n"
+        + "Reference test:\n" + prefix.getParent().getSourceCode() + "\n\n"
+        + "Variation to complete:\n" + prefix.getSourceCode() + "\n\n"
+        + "Write the JUnit assertion statements that must hold at the end of the variation.\n\n"
+        + "Rules:\n"
+        + "- Output ONLY assertion statements, one per line, each ending with a semicolon.\n"
+        + "- Use only the variables already declared in the variation. Do NOT declare new variables.\n"
+        + "- Do NOT repeat the method signature, the class, the existing statements, or any explanation.\n"
+        + "- Do NOT use markdown code fences.\n";
+  }
+
+  /**
+   * Perform the call to the Ollama generate API.
+   */
+  private String performCall(String prompt) {
+    try {
+      URL url = new URL(endpoint.getApiUrl());
+      HttpURLConnection con = (HttpURLConnection) url.openConnection();
+      con.setRequestMethod("POST");
+      con.setRequestProperty("Content-Type", "application/json");
+      // Without these an unreachable or wedged daemon hangs the whole run.
+      con.setConnectTimeout(timeoutMillis);
+      con.setReadTimeout(timeoutMillis);
+      JSONObject requestBody = new JSONObject();
+      requestBody.put("model", endpoint.getModel());
+      requestBody.put("system", SYSTEM);
+      requestBody.put("prompt", prompt);
+      requestBody.put("stream", false);
+      System.out.println("request: " + requestBody);
+      con.setDoOutput(true);
+      con.getOutputStream().write(requestBody.toString().getBytes(StandardCharsets.UTF_8));
+      StringBuilder response = new StringBuilder();
+      try (BufferedReader in = new BufferedReader(
+          new InputStreamReader(con.getInputStream(), StandardCharsets.UTF_8))) {
+        String inputLine;
+        while ((inputLine = in.readLine()) != null) {
+          response.append(inputLine).append("\n");
+        }
+      }
+      JSONObject jsonResponse = new JSONObject(response.toString());
+      String completion = jsonResponse.optString("response", "");
+      System.out.println("---> response: " + completion);
+      return completion;
+    } catch (Exception e) {
+      System.out.println("Error while performing the call to the model " + endpoint.getModel()
+          + " through Ollama at " + endpoint.getApiUrl());
+      e.printStackTrace();
+      throw new RuntimeException("Ollama call failed for " + endpoint, e);
+    }
+  }
+
+  /**
+   * Get assertions as strings from the response text.
+   *
+   * <p>Tolerates what instruction-tuned models add on top of the requested
+   * bare statements: markdown fences, inline reasoning blocks, comments, and
+   * assertions wrapped over several lines. Of the groups of consecutive
+   * assertions found, the last one is kept -- when a model re-emits the whole
+   * method despite the prompt, the completion it appended is at the end.
+   *
+   * @param text the response
+   * @return a list of assertion strings
+   */
+  static List<String> getAssertionsFromResponseText(String text) {
+    if (text == null) return new ArrayList<>();
+    String cleaned = REASONING_BLOCK.matcher(text).replaceAll("");
+    List<String> currentGroup = new ArrayList<>();
+    List<String> lastGroup = new ArrayList<>();
+    StringBuilder pending = new StringBuilder(); // assertion spanning several lines
+
+    for (String rawLine : cleaned.split("\\r?\\n")) {
+      String line = rawLine.trim();
+      // Transparent lines: they neither start nor break a group.
+      if (line.isEmpty() || line.startsWith("```") || line.startsWith("//")
+          || line.startsWith("/*") || line.startsWith("*") || line.equals("}")) continue;
+      if (pending.length() == 0 && !ASSERTION_START.matcher(line).find()) {
+        // Real code that is not an assertion: the group ends here.
+        if (!currentGroup.isEmpty()) {
+          lastGroup = currentGroup;
+          currentGroup = new ArrayList<>();
+        }
+        continue;
+      }
+      pending.append(pending.length() == 0 ? line : " " + line);
+      String candidate = pending.toString();
+      if (candidate.endsWith(";") && isBalanced(candidate)) {
+        currentGroup.add(candidate);
+        pending.setLength(0);
+      } else if (candidate.length() > 4000) {
+        pending.setLength(0); // runaway; give up on this one
+      }
+    }
+    if (!currentGroup.isEmpty()) lastGroup = currentGroup;
+
+    // A model asked twice for the same assertion sometimes emits it twice.
+    Set<String> unique = new LinkedHashSet<>(lastGroup);
+    return new ArrayList<>(unique);
+  }
+
+  /** True when every '(' in the statement is closed, ignoring string literals. */
+  private static boolean isBalanced(String statement) {
+    int depth = 0;
+    boolean inString = false;
+    boolean inChar = false;
+    for (int i = 0; i < statement.length(); i++) {
+      char c = statement.charAt(i);
+      if (i > 0 && statement.charAt(i - 1) == '\\') continue;
+      if (c == '"' && !inChar) inString = !inString;
+      else if (c == '\'' && !inString) inChar = !inChar;
+      else if (!inString && !inChar) {
+        if (c == '(') depth++;
+        else if (c == ')') depth--;
+      }
+    }
+    return depth == 0 && !inString && !inChar;
+  }
+
+  /**
+   * Update the class name with a new name
+   * @param prefix Prefix to update
+   */
+  private void updateClassName(Prefix prefix) {
+    String currentClassName = prefix.getClassName();
+    String newClassName = currentClassName + "withOllama" + modelSuffix();
+    prefix.setClassName(newClassName);
+    CompilationUnit compilationUnit = prefix.getMethodCompilationUnit();
+    compilationUnit.getClassByName(currentClassName).get().setName(newClassName);
+    TransformationHelper.updateCompilationUnitNames(compilationUnit, currentClassName, newClassName);
+  }
+
+  /** The model tag as a Java identifier fragment, e.g. 'gpt-oss:120b' -> 'Gptoss120b'. */
+  private String modelSuffix() {
+    StringBuilder sanitized = new StringBuilder();
+    for (char c : endpoint.getModel().toCharArray()) {
+      if (Character.isLetterOrDigit(c)) sanitized.append(c);
+    }
+    if (sanitized.length() == 0) return "";
+    sanitized.setCharAt(0, Character.toUpperCase(sanitized.charAt(0)));
+    return sanitized.toString();
+  }
+}
