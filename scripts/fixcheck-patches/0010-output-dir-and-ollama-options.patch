diff --git a/src/test/java/org/imdea/fixcheck/assertion/OllamaGeneratorTest.java b/src/test/java/org/imdea/fixcheck/assertion/OllamaGeneratorTest.java
new file mode 100644
index 0000000..811f379
--- /dev/null
+++ b/src/test/java/org/imdea/fixcheck/assertion/OllamaGeneratorTest.java
@@ -0,0 +1,45 @@
+package org.imdea.fixcheck.assertion;
+
+import org.imdea.fixcheck.properties.OllamaProperty;
+import org.json.JSONObject;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * OllamaGeneratorTest class: sampling options reach the request only when configured.
+ */
+public class OllamaGeneratorTest {
+
+  private static final OllamaProperty ENDPOINT =
+      OllamaProperty.parse("ollama:gpt-oss:120b@1995", null, null, -1);
+
+  @Test
+  public void samplingOptionsAreSentWhenConfigured() {
+    JSONObject body = new OllamaGenerator(ENDPOINT, 120, 0.0, 7L).buildRequestBody("prompt");
+
+    JSONObject options = body.getJSONObject("options");
+    assertEquals(0.0, options.getDouble("temperature"), 0.0);
+    assertEquals(7L, options.getLong("seed"));
+    assertEquals("gpt-oss:120b", body.getString("model"));
+    assertFalse(body.getBoolean("stream"));
+  }
+
+  @Test
+  public void noOptionsAreSentByDefault() {
+    JSONObject body = new OllamaGenerator(ENDPOINT, 120).buildRequestBody("prompt");
+
+    assertFalse(body.has("options"));
+  }
+
+  @Test
+  public void aSeedAloneIsSentWithoutATemperature() {
+    JSONObject options = new OllamaGenerator(ENDPOINT, 120, null, 7L)
+        .buildRequestBody("prompt").getJSONObject("options");
+
+    assertTrue(options.has("seed"));
+    assertFalse(options.has("temperature"));
+  }
+}
