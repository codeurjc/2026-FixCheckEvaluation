@@ -0,0 +1,59 @@
+package org.imdea.fixcheck.utils;
+
+import org.imdea.fixcheck.transform.input.provider.BooleanProvider;
+import org.imdea.fixcheck.transform.input.provider.DoubleProvider;
+import org.imdea.fixcheck.transform.input.provider.InputProvider;
+import org.imdea.fixcheck.transform.input.provider.IntegerProvider;
+import org.imdea.fixcheck.transform.input.provider.LongProvider;
+import org.imdea.fixcheck.transform.input.provider.StringProvider;
+import org.junit.After;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+
+/**
+ * RandomSourceTest class: every input provider draws from the one seedable source.
+ */
+public class RandomSourceTest {
+
+  @After
+  public void unseed() {
+    RandomSource.reset();
+  }
+
+  private static List<Object> draws() {
+    StringProvider strings = new StringProvider();
+    strings.addInput("seed");
+    strings.addInput("value");
+    List<InputProvider> providers = Arrays.asList(
+        new BooleanProvider(), new IntegerProvider(), new LongProvider(), new DoubleProvider(), strings);
+    List<Object> values = new ArrayList<>();
+    for (int i = 0; i < 20; i++) {
+      for (InputProvider provider : providers) values.add(provider.getInput());
+    }
+    return values;
+  }
+
+  @Test
+  public void theSameSeedDrawsTheSameInputs() {
+    RandomSource.setSeed(42);
+    List<Object> first = draws();
+    RandomSource.setSeed(42);
+
+    assertEquals(first, draws());
+  }
+
+  @Test
+  public void differentSeedsDrawDifferentInputs() {
+    RandomSource.setSeed(42);
+    List<Object> first = draws();
+    RandomSource.setSeed(43);
+
+    assertNotEquals(first, draws());
+  }
+}
