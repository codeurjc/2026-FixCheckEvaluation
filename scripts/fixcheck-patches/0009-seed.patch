new file mode 100644
index 0000000..68fb53e
--- /dev/null
+++ b/src/main/java/org/imdea/fixcheck/utils/RandomSource.java
@@ -0,0 +1,40 @@
+package org.imdea.fixcheck.utils;
+
+import java.util.Random;
+
+/**
+ * RandomSource class: the single source of randomness of the input transformation.
+ *
+ * <p>Which literal is mutated and the value it gets used to be drawn from a
+ * fresh {@code new Random()} at every call site, so two runs on the same
+ * subject never generated the same prefixes and a result could not be
+ * repeated. Seeding this one source (property {@code seed}) makes them repeat.
+ */
+public final class RandomSource {
+
+  private static Random random = new Random();
+
+  private RandomSource() {}
+
+  /**
+   * @return the shared random number generator
+   */
+  public static Random get() {
+    return random;
+  }
+
+  /**
+   * Restart the shared generator from the given seed.
+   * @param seed the seed
+   */
+  public static void setSeed(long seed) {
+    random = new Random(seed);
+  }
+
+  /**
+   * Go back to an unseeded generator.
+   */
+  public static void reset() {
+    random = new Random();
+  }
+}
