@@ -0,0 +1,55 @@
+package org.imdea.fixcheck.transform.input;
+
+import com.github.javaparser.ast.body.MethodDeclaration;
+import org.imdea.fixcheck.prefix.Prefix;
+import org.imdea.fixcheck.properties.FixCheckProperties;
+import org.imdea.fixcheck.transform.common.TransformationHelper;
+import org.imdea.fixcheck.utils.RandomSource;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+
+/**
+ * SeededInputTransformationTest class: a seeded run mutates the same literals to the same values.
+ */
+public class SeededInputTransformationTest {
+
+  @Before
+  public void initialize() {
+    // The target methods live in PrimitiveInputTransformationsTest's TargetClass.
+    FixCheckProperties.TEST_CLASS_SRC_DIR = "src/test/java";
+    FixCheckProperties.TEST_CLASS = "org.imdea.fixcheck.transform.input.PrimitiveInputTransformationsTest";
+    FixCheckProperties.setup();
+    InputHelper.initializeHelper();
+    FixCheckProperties.INPUTS_CLASS = "int";
+  }
+
+  @After
+  public void unseed() {
+    RandomSource.reset();
+  }
+
+  private static List<String> transformations(long seed) {
+    RandomSource.setSeed(seed);
+    InputTransformer transformer = new InputTransformer();
+    MethodDeclaration method = TransformationHelper.getMethodDeclFromCompilationUnit(
+        FixCheckProperties.TEST_CLASS_SRC, "testIntMethod");
+    Prefix prefix = new Prefix(method, FixCheckProperties.TEST_CLASS_SRC);
+    List<String> applied = new ArrayList<>();
+    for (int i = 0; i < 10; i++) {
+      transformer.transform(prefix);
+      applied.add(transformer.getLastTransformation());
+    }
+    return applied;
+  }
+
+  @Test
+  public void theSameSeedMutatesTheSameWay() {
+    assertEquals(transformations(7), transformations(7));
+  }
+}
