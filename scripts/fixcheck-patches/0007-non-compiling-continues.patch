diff --git a/src/test/java/org/imdea/fixcheck/FixCheckTest.java b/src/test/java/org/imdea/fixcheck/FixCheckTest.java
new file mode 100644
index 0000000..c1c7c9a
--- /dev/null
+++ b/src/test/java/org/imdea/fixcheck/FixCheckTest.java
@@ -0,0 +1,46 @@
+package org.imdea.fixcheck;
+
+import com.github.javaparser.StaticJavaParser;
+import com.github.javaparser.ast.CompilationUnit;
+import com.github.javaparser.ast.body.MethodDeclaration;
+import org.imdea.fixcheck.prefix.Prefix;
+import org.junit.Test;
+import org.junit.runner.Description;
+import org.junit.runner.Result;
+import org.junit.runner.notification.Failure;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * FixCheckTest class: the generation loop survives prefixes that do not compile.
+ */
+public class FixCheckTest {
+
+  private static Prefix prefixWith(Result result) {
+    CompilationUnit unit = StaticJavaParser.parse("class SampleTest { void testSomething() {} }");
+    MethodDeclaration method = unit.findFirst(MethodDeclaration.class).get();
+    Prefix prefix = new Prefix(method, unit);
+    prefix.setExecutionResult(result);
+    return prefix;
+  }
+
+  @Test
+  public void aPrefixThatDidNotCompileGetsNoAssertionsAndDoesNotThrow() {
+    assertFalse(FixCheck.shouldGenerateAssertions(prefixWith(null)));
+  }
+
+  @Test
+  public void aPassingPrefixGetsAssertions() {
+    assertTrue(FixCheck.shouldGenerateAssertions(prefixWith(new Result())));
+  }
+
+  @Test
+  public void aFailingPrefixGetsNoAssertions() throws Exception {
+    Result result = new Result();
+    result.createListener().testFailure(
+        new Failure(Description.createTestDescription(FixCheckTest.class, "sample"), new RuntimeException("boom")));
+
+    assertFalse(FixCheck.shouldGenerateAssertions(prefixWith(result)));
+  }
+}
