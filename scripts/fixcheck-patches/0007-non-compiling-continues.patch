+  /**
+   * Whether to generate assertions for a prefix that has just run without them:
+   * only when it compiled and did not fail. A prefix that did not compile has no
+   * execution result; dereferencing it used to abort the whole run with a
+   * NullPointerException, losing every prefix generated until then. Now it is
+   * recorded as non-compiling and generation goes on.
+   * @param prefix the prefix, after its first execution
+   * @return true if assertions should be generated for it
+   */
+  static boolean shouldGenerateAssertions(Prefix prefix) {
+    Result result = prefix.getExecutionResult();
+    return result != null && result.getFailureCount() == 0;
+  }
