+package org.imdea.fixcheck.compilation;
+
+import java.io.File;
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * SubjectClassLoader class: defines a prefix and the subject under analysis in
+ * one class loader.
+ *
+ * <p>The JVM only treats two classes as members of the same package when the
+ * same loader defined them. With the subject on the application class path and
+ * the prefix defined by {@link InMemoryClassLoader}, every access from the
+ * prefix to a package-private or protected member of the subject or its tests
+ * raised {@code IllegalAccessError}, and any library bundled with FixCheck
+ * shadowed the subject's class of the same name.
+ *
+ * <p>Lookup is child-first: the in-memory prefix classes, then the subject's
+ * class path, then the parent. Only the platform and the test framework are
+ * asked of the parent first, so that the JUnit runner FixCheck drives and the
+ * tests it runs agree on {@code TestCase}, {@code Assert} and friends.
+ */
+public class SubjectClassLoader extends URLClassLoader {
+
+  private static final String[] PARENT_FIRST = {
+      "java.", "javax.", "sun.", "jdk.", "junit.", "org.junit.", "org.hamcrest."
+  };
+
+  private final Map<String, JavaClassAsBytes> inMemoryClasses;
+
+  /**
+   * @param subjectClasspath the subject's class path, entries separated by the platform path separator
+   * @param parent loader of FixCheck itself (provides the JDK and JUnit)
+   * @param inMemoryClasses classes compiled in memory, by binary name; may be null
+   */
+  public SubjectClassLoader(String subjectClasspath, ClassLoader parent,
+                            Map<String, JavaClassAsBytes> inMemoryClasses) {
+    super(toUrls(subjectClasspath), parent);
+    this.inMemoryClasses = inMemoryClasses == null
+        ? Collections.<String, JavaClassAsBytes>emptyMap() : inMemoryClasses;
+  }
+
+  @Override
+  protected Class<?> loadClass(String name, boolean resolve) throws ClassNotFoundException {
+    synchronized (getClassLoadingLock(name)) {
+      Class<?> loaded = findLoadedClass(name);
+      if (loaded == null) {
+        if (isParentFirst(name)) {
+          try {
+            loaded = getParent().loadClass(name);
+          } catch (ClassNotFoundException e) {
+            loaded = findClass(name);
+          }
+        } else {
+          try {
+            loaded = findClass(name);
+          } catch (ClassNotFoundException e) {
+            loaded = getParent().loadClass(name);
+          }
+        }
+      }
+      if (resolve) resolveClass(loaded);
+      return loaded;
+    }
+  }
+
+  @Override
+  protected Class<?> findClass(String name) throws ClassNotFoundException {
+    JavaClassAsBytes compiled = inMemoryClasses.get(name);
+    if (compiled != null) {
+      byte[] bytes = compiled.getBytes();
+      return defineClass(name, bytes, 0, bytes.length);
+    }
+    return super.findClass(name);
+  }
+
+  @Override
+  public URL getResource(String name) {
+    // Child-first as well: tests load fixtures from their own class path.
+    URL url = findResource(name);
+    return url != null ? url : super.getResource(name);
+  }
+
+  private static boolean isParentFirst(String name) {
+    for (String prefix : PARENT_FIRST) {
+      if (name.startsWith(prefix)) return true;
+    }
+    return false;
+  }
+
+  /**
+   * Turn a class path string into URLs. A trailing {@code *} entry stands for
+   * every jar in its directory, as it does for {@code java -cp} and {@code javac}.
+   */
+  static URL[] toUrls(String classpath) {
+    List<URL> urls = new ArrayList<>();
+    if (classpath == null) return new URL[0];
+    for (String entry : classpath.split(File.pathSeparator)) {
+      if (entry.isEmpty()) continue;
+      try {
+        if (entry.equals("*") || entry.endsWith(File.separator + "*")) {
+          File dir = new File(entry.substring(0, entry.length() - 1));
+          File[] jars = dir.listFiles((d, n) -> n.endsWith(".jar") || n.endsWith(".JAR"));
+          if (jars == null) continue;
+          java.util.Arrays.sort(jars);
+          for (File jar : jars) urls.add(jar.toURI().toURL());
+        } else {
+          urls.add(new File(entry).toURI().toURL());
+        }
+      } catch (MalformedURLException e) {
+        throw new IllegalArgumentException("Invalid class path entry: " + entry, e);
+      }
+    }
+    return urls.toArray(new URL[0]);
+  }
+}
