+package org.imdea.fixcheck.properties;
+
+import org.junit.After;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+/**
+ * FixCheckPropertiesTest class: optional properties are read from the properties file.
+ */
+public class FixCheckPropertiesTest {
+
+  @Rule
+  public TemporaryFolder tmp = new TemporaryFolder();
+
+  private static final String LAUNCHER_CLASSPATH = System.getProperty("java.class.path");
+
+  /** A properties file with every required property, plus the given extra lines. */
+  private String propertiesFile(String... extra) throws IOException {
+    File file = tmp.newFile();
+    List<String> lines = new ArrayList<>(Arrays.asList(
+        "test-classes-path=/subject/tests",
+        "test-class=subject.SubjectTest",
+        "test-methods=testSomething",
+        "test-classes-src=/subject/src/test",
+        "test-failure-trace-log=/subject/failing_tests",
+        "inputs-class=int",
+        "number-of-prefixes=3",
+        "assertion-generator=previous-assertion"));
+    lines.addAll(Arrays.asList(extra));
+    Files.write(file.toPath(), lines, StandardCharsets.UTF_8);
+    return file.getAbsolutePath();
+  }
+
+  @After
+  public void restoreDefaults() {
+    FixCheckProperties.SUBJECT_CLASSPATH = null;
+    FixCheckProperties.FULL_CLASSPATH = LAUNCHER_CLASSPATH;
+  }
+
+  @Test
+  public void withoutSubjectClasspathCompilationUsesTheLauncherClasspath() throws IOException {
+    FixCheckProperties.loadProperties(propertiesFile());
+
+    assertNull(FixCheckProperties.SUBJECT_CLASSPATH);
+    assertEquals(LAUNCHER_CLASSPATH, FixCheckProperties.FULL_CLASSPATH);
+  }
+
+  @Test
+  public void subjectClasspathComesFirstForCompilation() throws IOException {
+    String subject = "/subject/classes" + File.pathSeparator + "/subject/tests";
+
+    FixCheckProperties.loadProperties(propertiesFile("subject-classpath=" + subject));
+
+    assertEquals(subject, FixCheckProperties.SUBJECT_CLASSPATH);
+    assertEquals(subject + File.pathSeparator + LAUNCHER_CLASSPATH, FixCheckProperties.FULL_CLASSPATH);
+  }
+}
