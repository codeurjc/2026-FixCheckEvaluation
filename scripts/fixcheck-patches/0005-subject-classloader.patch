+  /**
+   * Load the subject's class path, when it is given apart from FixCheck's own.
+   *
+   * <p>With the subject on {@code java -cp} next to FixCheck, the application
+   * class loader defines the subject's classes while an in-memory loader
+   * defines the prefixes: two loaders make two runtime packages, so every
+   * package-private or protected member a test touches raises
+   * {@code IllegalAccessError}. With {@code subject-classpath} set, each prefix
+   * shares a {@link org.imdea.fixcheck.compilation.SubjectClassLoader} with the
+   * subject instead. Compilation sees the subject first and FixCheck's own
+   * class path last, which only has to provide JUnit.
+   */
+  private static void loadSubjectClasspath(Properties prop) {
+    String launcherClasspath = System.getProperty("java.class.path");
+    String subject = prop.getProperty("subject-classpath");
+    FixCheckProperties.SUBJECT_CLASSPATH =
+        (subject == null || subject.trim().isEmpty()) ? null : subject.trim();
+    FixCheckProperties.FULL_CLASSPATH = FixCheckProperties.SUBJECT_CLASSPATH == null
+        ? launcherClasspath
+        : FixCheckProperties.SUBJECT_CLASSPATH + File.pathSeparator + launcherClasspath;
+  }
