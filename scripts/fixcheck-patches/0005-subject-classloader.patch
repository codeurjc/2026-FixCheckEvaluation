diff --git a/src/test/java/org/imdea/fixcheck/compilation/SubjectClassLoaderTest.java b/src/test/java/org/imdea/fixcheck/compilation/SubjectClassLoaderTest.java
new file mode 100644
index 0000000..30ae61e
--- /dev/null
+++ b/src/test/java/org/imdea/fixcheck/compilation/SubjectClassLoaderTest.java
@@ -0,0 +1,147 @@
+package org.imdea.fixcheck.compilation;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import javax.tools.DiagnosticCollector;
+import javax.tools.JavaCompiler;
+import javax.tools.JavaFileObject;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.StandardLocation;
+import javax.tools.ToolProvider;
+import java.io.File;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.util.Arrays;
+import java.util.Collections;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+/**
+ * SubjectClassLoaderTest class: a prefix and the subject must share runtime packages.
+ */
+public class SubjectClassLoaderTest {
+
+  @Rule
+  public TemporaryFolder tmp = new TemporaryFolder();
+
+  private static final String SUBJECT =
+      "package subject;\n"
+    + "public class Subject {\n"
+    + "  static int secret() { return 42; }\n"
+    + "}\n";
+
+  private static final String PREFIX =
+      "package subject;\n"
+    + "public class Prefix {\n"
+    + "  public static int callSecret() { return Subject.secret(); }\n"
+    + "}\n";
+
+  // A subject class that happens to share its name with one of FixCheck's own.
+  private static final String NAMESAKE =
+      "package org.imdea.fixcheck.utils;\n"
+    + "public class Stats {\n"
+    + "  public static String origin() { return \"subject\"; }\n"
+    + "}\n";
+
+  /** Compile sources to a directory, the way a subject's classes sit on disk. */
+  private File compileToDirectory(String name, String source) throws Exception {
+    File out = tmp.newFolder();
+    JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+    DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+    StandardJavaFileManager fileManager = compiler.getStandardFileManager(null, null, null);
+    fileManager.setLocation(StandardLocation.CLASS_OUTPUT, Collections.singletonList(out));
+    boolean ok = compiler.getTask(null, fileManager, diagnostics, null, null,
+        Collections.singletonList(new JavaSourceFromString(name, source))).call();
+    assertTrue(diagnostics.getDiagnostics().toString(), ok);
+    return out;
+  }
+
+  /** Compile the prefix in memory against the subject, the way PrefixRunner does. */
+  private InMemoryFileManager compilePrefix(File subjectClasses) {
+    JavaCompiler compiler = ToolProvider.getSystemJavaCompiler();
+    DiagnosticCollector<JavaFileObject> diagnostics = new DiagnosticCollector<>();
+    InMemoryFileManager manager = new InMemoryFileManager(compiler.getStandardFileManager(null, null, null));
+    boolean ok = compiler.getTask(null, manager, diagnostics,
+        Arrays.asList("-classpath", subjectClasses.getAbsolutePath()), null,
+        Collections.singletonList(new JavaSourceFromString("subject.Prefix", PREFIX))).call();
+    assertTrue(diagnostics.getDiagnostics().toString(), ok);
+    return manager;
+  }
+
+  @Test
+  public void prefixReachesPackagePrivateMembersOfTheSubject() throws Exception {
+    File subjectClasses = compileToDirectory("subject.Subject", SUBJECT);
+    InMemoryFileManager manager = compilePrefix(subjectClasses);
+    SubjectClassLoader loader = new SubjectClassLoader(
+        subjectClasses.getAbsolutePath(), getClass().getClassLoader(), manager.getBytesMap());
+
+    Method callSecret = loader.loadClass("subject.Prefix").getMethod("callSecret");
+
+    assertEquals(42, callSecret.invoke(null));
+  }
+
+  @Test
+  public void prefixDefinedByAnotherLoaderThanTheSubjectCannot() throws Exception {
+    // The layout FixCheck used before: subject on one loader, prefix on a child.
+    File subjectClasses = compileToDirectory("subject.Subject", SUBJECT);
+    InMemoryFileManager manager = compilePrefix(subjectClasses);
+    URLClassLoader subjectLoader = new URLClassLoader(
+        new URL[]{subjectClasses.toURI().toURL()}, getClass().getClassLoader());
+    InMemoryClassLoader prefixLoader = new InMemoryClassLoader(subjectLoader, manager);
+
+    Method callSecret = prefixLoader.loadClass("subject.Prefix").getMethod("callSecret");
+
+    try {
+      callSecret.invoke(null);
+      fail("expected IllegalAccessError across class loaders");
+    } catch (InvocationTargetException e) {
+      assertTrue(String.valueOf(e.getCause()), e.getCause() instanceof IllegalAccessError);
+    }
+  }
+
+  @Test
+  public void subjectClassesWinOverFixChecksOwn() throws Exception {
+    File subjectClasses = compileToDirectory("org.imdea.fixcheck.utils.Stats", NAMESAKE);
+    SubjectClassLoader loader = new SubjectClassLoader(
+        subjectClasses.getAbsolutePath(), getClass().getClassLoader(), null);
+
+    Class<?> stats = loader.loadClass("org.imdea.fixcheck.utils.Stats");
+
+    assertSame(loader, stats.getClassLoader());
+    assertEquals("subject", stats.getMethod("origin").invoke(null));
+  }
+
+  @Test
+  public void testFrameworkIsSharedWithTheParent() throws Exception {
+    File subjectClasses = compileToDirectory("subject.Subject", SUBJECT);
+    SubjectClassLoader loader = new SubjectClassLoader(
+        subjectClasses.getAbsolutePath(), getClass().getClassLoader(), null);
+
+    assertSame(org.junit.Test.class, loader.loadClass("org.junit.Test"));
+    assertSame(junit.framework.TestCase.class, loader.loadClass("junit.framework.TestCase"));
+  }
+
+  @Test
+  public void classpathWildcardExpandsToTheJarsOfItsDirectory() throws Exception {
+    File lib = tmp.newFolder("lib");
+    assertTrue(new File(lib, "b.jar").createNewFile());
+    assertTrue(new File(lib, "a.jar").createNewFile());
+    assertTrue(new File(lib, "notes.txt").createNewFile());
+    File classes = tmp.newFolder("classes");
+
+    URL[] urls = SubjectClassLoader.toUrls(
+        classes.getAbsolutePath() + File.pathSeparator + File.pathSeparator
+            + lib.getAbsolutePath() + File.separator + "*");
+
+    assertEquals(3, urls.length);
+    assertTrue(urls[1].getPath().endsWith("/a.jar"));
+    assertTrue(urls[2].getPath().endsWith("/b.jar"));
+  }
+}
